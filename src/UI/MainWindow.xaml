<Window x:Class="TvDesk.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TvDesk.Core"
        xmlns:ui="clr-namespace:TvDesk.UI"
        Title="TvDesk" Width="1200" Height="760" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Resources/icon.ico">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="80"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================================================================ sidebar -->
    <Border Grid.RowSpan="2" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"/>

    <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
      <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentBrush}">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
      </Border>
      <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="TvDesk" FontSize="16.5" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
        <TextBlock Text="{l:T app_tagline}" FontSize="10.5" Foreground="{StaticResource Text3Brush}" Margin="0,-1,0,0"/>
      </StackPanel>
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="12,4,12,14">
      <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Click="OnAddClick" Height="42" Margin="2,10,2,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0"/>
          <TextBlock Text="{l:T btn_add}"/>
        </StackPanel>
      </Button>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T nav_watch}" Margin="14,10,0,6"/>
          <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{l:T nav_browse}"
                       IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=Browse}"/>
          <RadioButton Style="{StaticResource NavItem}" Tag="&#xE734;" Content="{l:T nav_favorites}"
                       IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=Favorites}"/>
          <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="{l:T nav_recent}"
                       IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=Recent}"/>
          <RadioButton Style="{StaticResource NavItem}" Tag="&#xE71B;" Content="{l:T nav_mine}"
                       IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=Mine}"/>

          <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T nav_manage}"/>
          <RadioButton Style="{StaticResource NavItem}" Tag="&#xE774;" Content="{l:T nav_sources}"
                       IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=Sources}"/>
          <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{l:T nav_settings}"
                       IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=Settings}"/>

          <!-- Quick tips card -->
          <Border Margin="2,20,2,0" Padding="14,12" CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{l:T hotkeys_title}" FontWeight="SemiBold" FontSize="12"/>
              </StackPanel>
              <Grid Margin="0,8,0,0" TextElement.FontSize="11.5" TextElement.Foreground="{StaticResource Text2Brush}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Ctrl+Alt+P" FlowDirection="LeftToRight" Margin="0,2,10,2" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{l:T hk_play}" Margin="0,2"/>
                <TextBlock Grid.Row="1" Text="Ctrl+Alt+M" FlowDirection="LeftToRight" Margin="0,2,10,2" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{l:T hk_mute}" Margin="0,2"/>
                <TextBlock Grid.Row="2" Text="Ctrl+Alt+D" FlowDirection="LeftToRight" Margin="0,2,10,2" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{l:T hk_icons}" Margin="0,2"/>
                <TextBlock Grid.Row="3" Text="Ctrl+Alt+←/→" FlowDirection="LeftToRight" Margin="0,2,10,2" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{l:T hk_next}" Margin="0,2" TextWrapping="Wrap"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ================================================================ title bar (search + caption buttons) -->
    <Grid Grid.Column="1">
      <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Width="440" HorizontalAlignment="Left" Margin="28,0,0,0"
               VerticalAlignment="Center" Tag="{l:T search_placeholder}"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               WindowChrome.IsHitTestVisibleInChrome="True"
               Visibility="{Binding ShowOnboarding, Converter={StaticResource InvBoolVis}}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="{l:T tip_minimize}"/>
        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize"/>
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="{l:T tip_close}"/>
      </StackPanel>
    </Grid>

    <!-- ================================================================ pages -->
    <Grid Grid.Row="1" Grid.Column="1">
      <ui:ChannelsView Visibility="{Binding IsChannelsPage, Converter={StaticResource BoolVis}}"/>
      <ui:SourcesView Visibility="{Binding IsSourcesPage, Converter={StaticResource BoolVis}}"/>
      <ui:SettingsView Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolVis}}"/>
    </Grid>

    <!-- ================================================================ now playing bar -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- now playing -->
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="48" Height="48" CornerRadius="12" Background="{Binding NowChannel.AccentBrush, FallbackValue={StaticResource Surface2Brush}}" ClipToBounds="True">
            <Grid>
              <TextBlock Text="{Binding NowChannel.Initials, FallbackValue=TV}" FontWeight="Bold" FontSize="16" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
              <Border Background="#EEF0F4" CornerRadius="12" Visibility="{Binding NowChannel.HasLogo, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                <Image Source="{Binding NowChannel.Logo}" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" FlowDirection="LeftToRight"/>
              </Border>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding NowName}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Ellipse Width="7" Height="7" Fill="{Binding NowStatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding NowStatus}" Foreground="{StaticResource Text2Brush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- transport -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding ReconnectCommand}" ToolTip="{l:T tip_reconnect}" Margin="0,0,10,0"/>
          <Button Style="{StaticResource RoundPlayButton}" Content="{Binding PlayGlyph}" Command="{Binding TogglePlayCommand}" ToolTip="{Binding PlayTooltip}"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE7F8;" Command="{Binding ToggleIconsCommand}" ToolTip="{Binding IconsTooltip}" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- volume -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Content="{Binding MuteGlyph}" Command="{Binding ToggleMuteCommand}" ToolTip="{l:T tip_mute}"/>
          <Slider Width="130" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" Margin="6,0,10,0"
                  SmallChange="2" LargeChange="10"/>
          <TextBlock Text="{Binding VolumeText}" Width="26" Foreground="{StaticResource Text2Brush}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================================================================ toast -->
    <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
            Background="#2A303C" BorderBrush="#3A4252" BorderThickness="1" CornerRadius="20" Padding="18,10"
            Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}" IsHitTestVisible="False">
      <TextBlock Text="{Binding ToastText}" FontSize="12.5" MaxWidth="560" TextTrimming="CharacterEllipsis"/>
    </Border>

    <!-- ================================================================ first run -->
    <ui:OnboardingView Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2"
                       Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolVis}}"/>
  </Grid>
</Window>
