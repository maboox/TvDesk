<Window x:Class="TvDesk.UI.DesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="TvDesk" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="False" Background="Black"
        WindowStartupLocation="Manual">
    <Grid>
        <vlc:VideoView x:Name="VideoView"/>
        <Border x:Name="DimOverlay" Background="Black" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</Window>
