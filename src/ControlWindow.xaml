<Window x:Class="TvDesk.UI.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TvDesk" Height="720" Width="460"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#0B0D12" Foreground="#E8EAF0"
        FontFamily="Segoe UI, Tahoma" FontSize="13">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#151823"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#3B5BFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0F1420"/>
      <Setter Property="Foreground" Value="#E8EAF0"/>
      <Setter Property="BorderBrush" Value="#2A3142"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8EAF0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="📺  TvDesk" FontSize="24" FontWeight="Bold"/>
      <TextBlock Text="تلویزیون و والپیپر زندهٔ دسکتاپ" Foreground="#8A92A6" FontSize="12" Margin="0,2,0,0"/>
      <Border Background="#0F1420" CornerRadius="8" Padding="10,7" Margin="0,10,0,0">
        <TextBlock x:Name="StatusText" Text="آماده" Foreground="#9FB4FF" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </Border>
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
      <DockPanel LastChildFill="True">
        <Button x:Name="PlayLinkButton" DockPanel.Dock="Left" Content="پخش" Width="78" Margin="8,0,0,0" Click="OnPlayLink"/>
        <TextBox x:Name="LinkBox" ToolTip="لینک یوتیوب / آپارات / تلوبیون یا m3u8"/>
      </DockPanel>
    </Border>

    <TextBox x:Name="SearchBox" Grid.Row="2" Margin="0,0,0,10" TextChanged="OnSearchChanged" ToolTip="جستجوی کانال…"/>

    <Grid Grid.Row="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="GroupCombo" Grid.Column="0" Margin="0,0,6,0" Padding="6" SelectionChanged="OnGroupChanged"/>
      <ComboBox x:Name="QualityCombo" Grid.Column="1" Margin="0,0,6,0" Padding="6" SelectionChanged="OnQualityChanged">
        <ComboBoxItem Content="کیفیت: خودکار" Tag="Auto"/>
        <ComboBoxItem Content="کیفیت: بالا" Tag="High"/>
        <ComboBoxItem Content="کیفیت: متوسط" Tag="Medium"/>
        <ComboBoxItem Content="کیفیت: پایین" Tag="Low"/>
      </ComboBox>
      <CheckBox x:Name="FavOnly" Grid.Column="2" Content="★ منتخب‌ها" Click="OnFavOnlyChanged"/>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="6">
      <ListBox x:Name="ChannelList" Background="Transparent" BorderThickness="0"
               Foreground="#E8EAF0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectionChanged="OnChannelSelected">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="4,5">
              <Border Width="34" Height="34" CornerRadius="6" Background="#0F1420" Margin="0,0,10,0">
                <Image Width="30" Height="30" Source="{Binding LogoUrl}" Stretch="Uniform"/>
              </Border>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="🔊 صدا" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
        </Grid>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="🌙 تاریکی" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Slider Grid.Column="1" x:Name="DimSlider" Minimum="0" Maximum="0.85" SmallChange="0.05" VerticalAlignment="Center" ValueChanged="OnDimChanged"/>
        </Grid>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" x:Name="MuteButton" Content="🔇 میوت" Margin="0,0,5,0" Click="OnMute"/>
          <Button Grid.Column="1" Content="★ منتخب" Margin="5,0" Background="#2A3142" Click="OnToggleFavorite"/>
          <Button Grid.Column="2" Content="آیکون‌ها" Margin="5,0,0,0" Background="#2A3142" Click="OnToggleIcons"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
