<UserControl x:Class="TvDesk.UI.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TvDesk.Core">
  <UserControl.Resources>
    <DataTemplate x:Key="SourceCard">
      <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Surface2Brush}" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0,16,0">
            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <ContentControl Style="{StaticResource Spinner}" Width="12" Height="12" Margin="0,0,8,0"
                              Visibility="{Binding Loading, Converter={StaticResource BoolVis}}"/>
              <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="OnRemove" ToolTip="{l:T menu_remove}" Margin="0,0,8,0"
                    Visibility="{Binding IsCustom, Converter={StaticResource BoolVis}}"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Click="OnHomepage" ToolTip="{l:T tip_homepage}" Margin="0,0,8,0"
                    Visibility="{Binding Homepage, Converter={StaticResource NotEmptyVis}}"/>
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,18,32,28" MaxWidth="920" HorizontalAlignment="Left">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Command="{Binding RefreshSourcesCommand}" VerticalAlignment="Center" Margin="16,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"/>
            <TextBlock Text="{l:T btn_refresh_all}"/>
          </StackPanel>
        </Button>
      </Grid>

      <TextBlock Text="{l:T sources_free}" Style="{StaticResource SectionLabel}" Margin="2,26,0,10"/>
      <ItemsControl ItemsSource="{Binding BuiltInSources}" ItemTemplate="{StaticResource SourceCard}"/>

      <Grid Margin="2,22,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:T sources_custom}" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="OnAddPlaylist" Padding="10,6">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="{l:T btn_add_playlist}" Foreground="{StaticResource TextBrush}"/>
          </StackPanel>
        </Button>
      </Grid>
      <ItemsControl ItemsSource="{Binding CustomSourceItems}" ItemTemplate="{StaticResource SourceCard}"/>
      <Border Style="{StaticResource Card}" Background="Transparent" BorderBrush="#2E3542" Padding="20"
              Visibility="{Binding HasCustomSources, Converter={StaticResource InvBoolVis}}">
        <StackPanel>
          <TextBlock Text="{l:T sources_custom_empty_title}" Style="{StaticResource H2}"/>
          <TextBlock Text="{l:T sources_custom_empty_text}" Style="{StaticResource Muted}" Margin="0,6,0,14"/>
          <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnAddPlaylist">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
              <TextBlock Text="{l:T btn_add_playlist}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <Border Margin="0,24,0,0" Padding="16,12" CornerRadius="12" Background="#14FFB547" BorderBrush="#33FFB547" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14" Foreground="{StaticResource WarnBrush}" Margin="0,0,10,0" VerticalAlignment="Top"/>
          <TextBlock Text="{l:T sources_legal}" Style="{StaticResource Muted}" MaxWidth="780"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
