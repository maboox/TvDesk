<UserControl x:Class="TvDesk.UI.ChannelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TvDesk.Core"
             xmlns:src="clr-namespace:TvDesk.Sources">
  <UserControl.Resources>

    <Style x:Key="ChannelRow" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <EventSetter Event="MouseLeftButtonUp" Handler="OnRowClick"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="10,0" Margin="0,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#55FF6A3D"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ChannelTemplate" DataType="{x:Type src:Channel}">
      <Grid Height="62" Background="Transparent">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{l:T menu_play}" Tag="&#xE768;" Click="OnMenuPlay"/>
            <MenuItem Header="{l:T menu_favorite}" Tag="&#xE734;" Click="OnMenuFavorite"/>
            <MenuItem Header="{l:T menu_test}" Tag="&#xE9D9;" Click="OnMenuTest"/>
            <MenuItem Header="{l:T menu_copy}" Tag="&#xE8C8;" Click="OnMenuCopy"/>
            <MenuItem Header="{l:T menu_remove}" Tag="&#xE74D;" Click="OnMenuRemove"
                      Visibility="{Binding IsUserLink, Converter={StaticResource BoolVis}}"/>
          </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- logo / initials -->
        <Border Width="44" Height="44" CornerRadius="11" Background="{Binding AccentBrush}" ClipToBounds="True" Margin="0,0,14,0">
          <Grid>
            <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="15" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
            <Border Background="#EEF0F4" CornerRadius="11" Visibility="{Binding HasLogo, Converter={StaticResource BoolVis}}">
              <Image Source="{Binding Logo}" Margin="5" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" FlowDirection="LeftToRight"/>
            </Border>
          </Grid>
        </Border>

        <!-- name + meta -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            <Border Style="{StaticResource Badge}" Background="{StaticResource AccentBrush}" BorderThickness="0"
                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{l:T badge_live}" Foreground="White" FontWeight="SemiBold"/>
            </Border>
            <Border Style="{StaticResource Badge}" Visibility="{Binding Quality, Converter={StaticResource NotEmptyVis}}">
              <TextBlock Text="{Binding Quality}" FlowDirection="LeftToRight"/>
            </Border>
            <Border Style="{StaticResource Badge}" Visibility="{Binding GeoBlocked, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{l:T badge_geo}" Foreground="{StaticResource WarnBrush}"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Text3Brush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- actions -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="{Binding HealthBrush}" Margin="8,0,10,0" VerticalAlignment="Center"
                   ToolTip="{Binding HealthText}" Visibility="{Binding HasHealth, Converter={StaticResource BoolVis}}"/>
          <Button Style="{StaticResource IconButton}" Content="{Binding FavGlyph}" Foreground="{Binding FavBrush}"
                  Click="OnFavoriteClick" ToolTip="{l:T menu_favorite}"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE768;" Click="OnPlayClick" ToolTip="{l:T menu_play}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================================================================ categories -->
    <DockPanel Margin="14,22,4,10">
      <TextBlock DockPanel.Dock="Top" Text="{l:T categories}" Style="{StaticResource SectionLabel}" Margin="10,0,0,8"/>
      <ListBox x:Name="CategoryList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource CategoryItem}"
               ItemsSource="{Binding CategoryItems}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
               VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="False">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13.5"/>
              <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat=N0}" FontSize="11" Foreground="{StaticResource Text3Brush}"
                         VerticalAlignment="Center" Margin="6,0,0,0" FlowDirection="LeftToRight"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- ================================================================ channel list -->
    <Grid Grid.Column="1" Margin="10,18,24,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- header -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}"/>
            <Border Style="{StaticResource Badge}" Margin="12,4,0,0">
              <TextBlock Text="{Binding ResultText}"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource ButtonBase}" Command="{Binding TestCommand}" ToolTip="{l:T tip_test}"
                  Visibility="{Binding IsTesting, Converter={StaticResource InvBoolVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="13" Margin="0,0,8,0"/>
              <TextBlock Text="{l:T btn_test}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ButtonBase}" Command="{Binding CancelTestCommand}"
                  Visibility="{Binding IsTesting, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
              <ContentControl Style="{StaticResource Spinner}" Width="16" Height="16" Margin="0,0,10,0"/>
              <TextBlock Text="{Binding TestText}"/>
              <TextBlock Text="  ·  " Foreground="{StaticResource Text3Brush}"/>
              <TextBlock Text="{l:T btn_cancel}" Foreground="{StaticResource Text2Brush}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- filters -->
      <WrapPanel Grid.Row="1" Margin="0,16,0,4">
        <ComboBox Width="200" Margin="0,0,8,8" ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                  DisplayMemberPath="Display" ToolTip="{l:T filter_country}"/>
        <ComboBox Width="180" Margin="0,0,8,8" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                  DisplayMemberPath="Display" ToolTip="{l:T filter_language}"/>
        <ComboBox Width="200" Margin="0,0,8,8" ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                  DisplayMemberPath="Display" ToolTip="{l:T filter_source}"/>
        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding OnlyWorking}" Margin="0,1,8,8">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{StaticResource GoodBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{l:T filter_only_working}"/>
          </StackPanel>
        </ToggleButton>
        <Button Style="{StaticResource GhostButton}" Command="{Binding ClearFiltersCommand}" Padding="10,7" Margin="0,0,0,8"
                Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" Margin="0,0,6,0"/>
            <TextBlock Text="{l:T btn_clear_filters}"/>
          </StackPanel>
        </Button>
      </WrapPanel>

      <!-- test progress -->
      <ProgressBar Grid.Row="2" Height="2" Minimum="0" Maximum="1" Value="{Binding TestProgress}" Margin="0,0,0,6"
                   Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0"
                   Visibility="{Binding IsTesting, Converter={StaticResource BoolVis}}"/>

      <!-- list -->
      <ListBox x:Name="ChannelList" Grid.Row="3" Style="{StaticResource PlainListBox}"
               ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelTemplate}"
               ItemContainerStyle="{StaticResource ChannelRow}"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
               KeyDown="OnListKeyDown" Padding="0,0,0,12"/>

      <!-- loading -->
      <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding IsLibraryLoading, Converter={StaticResource BoolVis}}">
        <ContentControl Style="{StaticResource Spinner}" Width="36" Height="36" HorizontalAlignment="Center"/>
        <TextBlock Text="{l:T loading_library}" Foreground="{StaticResource Text2Brush}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- empty state -->
      <Border Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
              Visibility="{Binding ResultCount, Converter={StaticResource ZeroVis}}">
        <StackPanel Visibility="{Binding IsLibraryLoading, Converter={StaticResource InvBoolVis}}">
          <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="26" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center"/>
          <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Style="{StaticResource ButtonBase}" Content="{l:T btn_clear_filters}" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,0"
                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolVis}}"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{l:T btn_open_sources}" Command="{Binding GoSourcesCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
