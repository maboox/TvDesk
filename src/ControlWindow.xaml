<Window x:Class="TvDesk.UI.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TvDesk" Height="760" Width="520"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#090B10" Foreground="#EEF2FF"
        FontFamily="Segoe UI, Tahoma" FontSize="13"
        MinWidth="500" MinHeight="680">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#141925"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="BorderBrush" Value="#252D3F"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#B9C7FF"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#4263FF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.86"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D1220"/>
      <Setter Property="Foreground" Value="#EEF2FF"/>
      <Setter Property="BorderBrush" Value="#2B344A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="7"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EEF2FF"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Background="#111827" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="📺 TvDesk" FontSize="28" FontWeight="Bold"/>
          <TextBlock Text="تلویزیون زنده و والپیپر ویدیویی دسکتاپ" Foreground="#8D99B5" Margin="0,3,0,0"/>
          <Border Background="#0B1020" CornerRadius="10" Padding="10,8" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="وضعیت فعلی" Foreground="#6F7C9D" FontSize="11"/>
              <TextBlock x:Name="StatusText" Text="آماده" Foreground="#AFC0FF" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <Button Grid.Column="1" Content="نمایش دسکتاپ" Background="#263149" Margin="12,0,0,0" VerticalAlignment="Top" Click="OnShowDesktopHint"/>
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="پخش لینک مستقیم / یوتیوب / آپارات / تلوبیون" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="لینک لایو یا m3u8 را وارد کن. اگر خواستی بعداً هم بماند، اسم بده و بزن «ذخیره در منتخب‌ها»." Foreground="#8D99B5" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Text="لینک" Foreground="#B8C0D8" Margin="0,0,0,4"/>
        <TextBox x:Name="LinkBox" ToolTip="YouTube live / Aparat / Telewebion / m3u8" Margin="0,0,0,8"/>
        <TextBlock Text="نام اختیاری برای ذخیره" Foreground="#B8C0D8" Margin="0,0,0,4"/>
        <TextBox x:Name="LinkNameBox" ToolTip="مثلاً: NASA Live یا شبکه مورد علاقه" Margin="0,0,0,10"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="▶ پخش لینک" Margin="0,0,6,0" Click="OnPlayLink"/>
          <Button Grid.Column="1" Content="★ ذخیره در منتخب‌ها" Background="#2D374F" Margin="6,0,0,0" Click="OnSaveLinkFavorite"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="جستجو و فیلتر کانال‌ها" Style="{StaticResource SectionTitle}"/>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,6,0">
            <TextBlock Text="جستجوی نام کانال" Foreground="#B8C0D8" Margin="0,0,0,4"/>
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <TextBlock Text="دسته‌بندی" Foreground="#B8C0D8" Margin="0,0,0,4"/>
            <ComboBox x:Name="GroupCombo" SelectionChanged="OnGroupChanged"/>
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="کیفیت ترجیحی" Foreground="#B8C0D8" Margin="0,0,0,4"/>
            <ComboBox x:Name="QualityCombo" SelectionChanged="OnQualityChanged">
              <ComboBoxItem Content="خودکار" Tag="Auto"/>
              <ComboBoxItem Content="بالا تا 1080p" Tag="High"/>
              <ComboBoxItem Content="متوسط تا 720p" Tag="Medium"/>
              <ComboBoxItem Content="پایین تا 480p" Tag="Low"/>
            </ComboBox>
          </StackPanel>
          <CheckBox x:Name="FavOnly" Grid.Column="1" Content="فقط منتخب‌ها" Margin="14,22,0,0" Click="OnFavOnlyChanged"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="لیست کانال‌ها و لینک‌های ذخیره‌شده" Style="{StaticResource SectionTitle}" Margin="6,6,6,8"/>
        <ListBox x:Name="ChannelList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 Foreground="#EEF2FF" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnChannelSelected">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="#0D1220" CornerRadius="12" Padding="8" Margin="4,4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="38" Height="38" CornerRadius="9" Background="#141B2B" Margin="0,0,10,0">
                    <Image Width="32" Height="32" Source="{Binding LogoUrl}" Stretch="Uniform"/>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Group}" Foreground="#7D8AA8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="2" Content="{Binding FavoriteText}" Tag="{Binding}" Background="#25304A" Padding="9,6" Click="OnFavoriteButtonClick"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="کنترل والپیپر" Style="{StaticResource SectionTitle}"/>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="46"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="صدا" VerticalAlignment="Center" Foreground="#B8C0D8"/>
          <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" ValueChanged="OnVolumeChanged"/>
          <TextBlock Grid.Column="2" x:Name="VolumeValue" Text="80%" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#8D99B5"/>
        </Grid>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="46"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="تاریکی" VerticalAlignment="Center" Foreground="#B8C0D8"/>
          <Slider Grid.Column="1" x:Name="DimSlider" Minimum="0" Maximum="0.85" SmallChange="0.05" ValueChanged="OnDimChanged"/>
          <TextBlock Grid.Column="2" x:Name="DimValue" Text="0%" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#8D99B5"/>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="🔇 میوت / صدا" Margin="0,0,6,0" Click="OnMute"/>
          <Button Grid.Column="1" Content="🖥 آیکون‌های دسکتاپ" Background="#2D374F" Margin="6,0" Click="OnToggleIcons"/>
          <Button Grid.Column="2" Content="★ منتخب انتخاب‌شده" Background="#2D374F" Margin="6,0,0,0" Click="OnToggleSelectedFavorite"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
