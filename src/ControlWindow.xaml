<Window x:Class="TvDesk.UI.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TvDesk" Height="780" Width="560" MinWidth="520" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="Transparent" AllowsTransparency="True" Foreground="#EEF2FF"
        FlowDirection="RightToLeft" FontFamily="Segoe UI, Tahoma" FontSize="13">
  <Window.Resources>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="true">
                <Track.Thumb>
                  <Thumb Background="#34405C" MinHeight="44">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="6"/></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#141925"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="BorderBrush" Value="#26314A"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#B9C7FF"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#4263FF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D1220"/>
      <Setter Property="Foreground" Value="#EEF2FF"/>
      <Setter Property="BorderBrush" Value="#2B344A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#0D1220"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="Padding" Value="7"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EEF2FF"/>
      <Setter Property="Margin" Value="0,4"/>
    </Style>
  </Window.Resources>

  <Border Background="#090B10" CornerRadius="18" BorderBrush="#2B344A" BorderThickness="1" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#111827" CornerRadius="18,18,0,0" MouseLeftButtonDown="OnTitleMouseDown">
        <Grid Margin="14,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" FlowDirection="LeftToRight">
            <Button Content="✕" Width="34" Height="30" Padding="0" Background="#293246" Margin="0,0,8,0" Click="OnClose"/>
            <Button Content="—" Width="34" Height="30" Padding="0" Background="#293246" Click="OnMinimize"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="TvDesk" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="📺" FontSize="18" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False">
        <StackPanel Margin="18">

          <Border x:Name="OnboardingPanel" Style="{StaticResource Card}" Background="#10192B" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="شروع اولیه / First setup" FontSize="20" FontWeight="Bold" Foreground="#D7E1FF" Margin="0,0,0,8"/>
              <TextBlock Text="زبان و سورس‌های اولیه را انتخاب کن. اگر هیچ لیستی نمی‌خواهی، همه را خاموش کن." Foreground="#9AA8C7" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <TextBlock Text="Language / زبان" Style="{StaticResource SectionTitle}"/>
              <ComboBox x:Name="LanguageCombo" Margin="0,0,0,12">
                <ComboBoxItem Content="فارسی" Tag="fa"/>
                <ComboBoxItem Content="English" Tag="en"/>
              </ComboBox>
              <TextBlock Text="سورس‌های اولیه" Style="{StaticResource SectionTitle}"/>
              <CheckBox x:Name="SourceTelewebionBox" Content="Telewebion / تلوبیون"/>
              <CheckBox x:Name="SourceIranBox" Content="iptv-org Iran"/>
              <CheckBox x:Name="SourceCategoriesBox" Content="iptv-org Categories"/>
              <CheckBox x:Name="SourceLanguagesBox" Content="iptv-org Languages"/>
              <CheckBox x:Name="SourceFreeTvBox" Content="Free-TV/IPTV"/>
              <Button Content="ذخیره و بارگذاری / Save" Margin="0,12,0,0" Click="OnCompleteOnboarding"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Background="#111827" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="📺 TvDesk" FontSize="26" FontWeight="Bold"/>
              <TextBlock Text="Live TV wallpaper with custom IPTV playlists" Foreground="#8D99B5" Margin="0,3,0,0"/>
              <Border Background="#0B1020" CornerRadius="10" Padding="10,8" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="وضعیت / Status" Foreground="#6F7C9D" FontSize="11"/>
                  <TextBlock x:Name="StatusText" Text="آماده" Foreground="#AFC0FF" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="پخش و ذخیره لینک" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="YouTube Live / Aparat / Telewebion / M3U8 / MP4" Foreground="#8D99B5" Margin="0,0,0,8"/>
              <TextBlock Text="لینک" Foreground="#B8C0D8" Margin="0,0,0,4"/>
              <TextBox x:Name="LinkBox" Margin="0,0,0,8"/>
              <TextBlock Text="نام برای ذخیره" Foreground="#B8C0D8" Margin="0,0,0,4"/>
              <TextBox x:Name="LinkNameBox" Margin="0,0,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="▶ پخش" Margin="0,0,6,0" Click="OnPlayLink"/>
                <Button Grid.Column="1" Content="★ ذخیره در منتخب‌ها" Background="#2D374F" Margin="6,0,0,0" Click="OnSaveLinkFavorite"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="افزودن سورس IPTV / M3U" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="لینک فایل m3u/m3u8 یک provider را بده تا به کتابخانه اضافه شود." Foreground="#8D99B5" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBox x:Name="PlaylistNameBox" Margin="0,0,0,8" ToolTip="نام سورس"/>
              <TextBox x:Name="PlaylistUrlBox" Margin="0,0,0,10" ToolTip="https://.../playlist.m3u"/>
              <Button Content="＋ افزودن سورس و بارگذاری" Background="#2D374F" Click="OnAddPlaylistSource"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="تنظیم رفتار صدا و تصویر" Style="{StaticResource SectionTitle}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Text="وقتی فوکوس خارج شد (استریم ادامه دارد)" Foreground="#B8C0D8" Margin="0,0,0,4"/>
                  <CheckBox x:Name="MuteFocusBox" Content="صدا قطع شود" Click="OnBehaviorChanged"/>
                  <CheckBox x:Name="PauseFocusBox" Content="تصویر فریز شود" Click="OnBehaviorChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="وقتی فول‌اسکرین شد (استریم ادامه دارد)" Foreground="#B8C0D8" Margin="0,0,0,4"/>
                  <CheckBox x:Name="MuteFullscreenBox" Content="صدا قطع شود" Click="OnBehaviorChanged"/>
                  <CheckBox x:Name="PauseFullscreenBox" Content="تصویر فریز شود" Click="OnBehaviorChanged"/>
                </StackPanel>
              </Grid>
              <Border Background="#0D1220" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                <CheckBox x:Name="AutoStartBox" Content="با شروع ویندوز TvDesk خودکار اجرا شود" Click="OnBehaviorChanged"/>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="جستجو و دسته‌بندی" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="جستجو" Foreground="#B8C0D8" Margin="0,0,0,4"/>
              <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Margin="0,0,0,10"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                  <TextBlock Text="کشور" Foreground="#B8C0D8" Margin="0,0,0,4"/>
                  <ComboBox x:Name="CountryCombo" SelectionChanged="OnFilterChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                  <TextBlock Text="سبک / ژانر" Foreground="#B8C0D8" Margin="0,0,0,4"/>
                  <ComboBox x:Name="GenreCombo" SelectionChanged="OnFilterChanged"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                  <TextBlock Text="سورس" Foreground="#B8C0D8" Margin="0,0,0,4"/>
                  <ComboBox x:Name="SourceCombo" SelectionChanged="OnFilterChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                  <TextBlock Text="وضعیت تست" Foreground="#B8C0D8" Margin="0,0,0,4"/>
                  <ComboBox x:Name="HealthCombo" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="همه وضعیت‌ها" Tag="all"/>
                    <ComboBoxItem Content="فقط سالم‌ها" Tag="alive"/>
                    <ComboBoxItem Content="فقط خراب‌ها" Tag="dead"/>
                    <ComboBoxItem Content="تست‌نشده‌ها" Tag="unknown"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="QualityCombo" SelectionChanged="OnQualityChanged">
                  <ComboBoxItem Content="کیفیت خودکار" Tag="Auto"/>
                  <ComboBoxItem Content="بالا تا 1080p" Tag="High"/>
                  <ComboBoxItem Content="متوسط تا 720p" Tag="Medium"/>
                  <ComboBoxItem Content="پایین تا 480p" Tag="Low"/>
                </ComboBox>
                <CheckBox x:Name="FavOnly" Grid.Column="1" Content="فقط منتخب‌ها" Margin="12,0,0,0" Click="OnFavOnlyChanged"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,12">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="کانال‌ها" Style="{StaticResource SectionTitle}" Margin="6"/>
              <ListBox x:Name="ChannelList" Grid.Row="1" Height="310" Background="Transparent" BorderThickness="0" Foreground="#EEF2FF"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                       SelectionChanged="OnChannelSelected">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#0D1220" CornerRadius="12" Padding="8" Margin="4">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="9" Background="#141B2B" Margin="0,0,10,0"><Image Width="32" Height="32" Source="{Binding LogoUrl}" Stretch="Uniform"/></Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Group}" Foreground="#7D8AA8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Source}" Foreground="#596783" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding HealthText}" Foreground="{Binding HealthBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Grid.Column="3" Content="{Binding FavoriteText}" Tag="{Binding}" Width="38" Background="#25304A" Click="OnFavoriteButtonClick"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid Grid.Row="2" Margin="6,8,6,4">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="⚡ تست فیلتر" Margin="0,0,5,0" Background="#2D374F" Click="OnQuickTestVisible"/>
                <Button Grid.Column="1" Content="⏹ Stop" Margin="5,0" Background="#5A2430" Click="OnStopPlayback"/>
                <Button Grid.Column="2" Content="↻ Restart" Margin="5,0" Background="#2D374F" Click="OnRestartPlayback"/>
                <Button Grid.Column="3" Content="🖥 آیکون‌ها" Margin="5,0,0,0" Background="#2D374F" Click="OnToggleIcons"/>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ResizeGrip Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"/>
    </Grid>
  </Border>
</Window>
