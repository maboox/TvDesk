<UserControl x:Class="TvDesk.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TvDesk.Core">
  <UserControl.Resources>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="RowHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Margin" Value="0,10"/>
    </Style>
    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{StaticResource LineBrush}"/>
      <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SettingCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Width" Value="230"/>
      <Setter Property="DisplayMemberPath" Value="Label"/>
      <Setter Property="SelectedValuePath" Value="Key"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,18,32,28" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}"/>
      <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,20"/>

      <!-- ===================================================== general -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Style="{StaticResource CardTitle}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{l:T set_general}" Style="{StaticResource H2}"/>
          </StackPanel>

          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{l:T set_language}" Style="{StaticResource RowLabel}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="فارسی" IsChecked="{Binding IsFarsi}"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="English" IsChecked="{Binding IsEnglish}"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_autostart}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{l:T set_autostart_hint}" Style="{StaticResource RowHint}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AutoStart}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_resume}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{l:T set_resume_hint}" Style="{StaticResource RowHint}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ResumeOnStart}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ===================================================== wallpaper -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Style="{StaticResource CardTitle}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{l:T set_wallpaper}" Style="{StaticResource H2}"/>
          </StackPanel>

          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_monitor}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{l:T set_monitor_hint}" Style="{StaticResource RowHint}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" ItemsSource="{Binding MonitorOptions}" SelectedValue="{Binding Monitor}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_fit}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{l:T set_fit_hint}" Style="{StaticResource RowHint}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" ItemsSource="{Binding FitOptions}" SelectedValue="{Binding Fit}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_quality}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{l:T set_quality_hint}" Style="{StaticResource RowHint}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" ItemsSource="{Binding QualityOptions}" SelectedValue="{Binding Quality}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ===================================================== smart pause -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Style="{StaticResource CardTitle}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{l:T set_smart}" Style="{StaticResource H2}"/>
          </StackPanel>
          <TextBlock Text="{l:T set_smart_hint}" Style="{StaticResource RowHint}" Margin="0,0,0,6"/>

          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{l:T set_on_fullscreen}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" ItemsSource="{Binding ActionOptions}" SelectedValue="{Binding OnFullscreen}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{l:T set_on_maximized}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" ItemsSource="{Binding ActionOptions}" SelectedValue="{Binding OnMaximized}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{l:T set_on_focus}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" ItemsSource="{Binding ActionOptions}" SelectedValue="{Binding OnAppFocused}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{l:T set_on_battery}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" ItemsSource="{Binding ActionOptions}" SelectedValue="{Binding OnBattery}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{l:T set_on_locked}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" ItemsSource="{Binding ActionOptions}" SelectedValue="{Binding OnLocked}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ===================================================== channels -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Style="{StaticResource CardTitle}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{l:T set_channels}" Style="{StaticResource H2}"/>
          </StackPanel>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_hide_broken}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{l:T set_hide_broken_hint}" Style="{StaticResource RowHint}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding HideBroken}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_hide_geo}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{l:T set_hide_geo_hint}" Style="{StaticResource RowHint}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding HideGeoBlocked}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{l:T set_hide_adult}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding HideAdult}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_refresh}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{l:T set_refresh_hint}" Style="{StaticResource RowHint}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" ItemsSource="{Binding RefreshOptions}" SelectedValue="{Binding RefreshHours}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ===================================================== network & performance -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Style="{StaticResource CardTitle}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{l:T set_advanced}" Style="{StaticResource H2}"/>
          </StackPanel>

          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_proxy}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{l:T set_proxy_hint}" Style="{StaticResource RowHint}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" ItemsSource="{Binding ProxyOptions}" SelectedValue="{Binding Proxy}"/>
          </Grid>
          <Grid Margin="0,0,0,10" Visibility="{Binding IsCustomProxy, Converter={StaticResource BoolVis}}">
            <TextBox Text="{Binding CustomProxy, UpdateSourceTrigger=LostFocus}" Tag="http://127.0.0.1:10809" FlowDirection="LeftToRight"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_hw}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{l:T set_hw_hint}" Style="{StaticResource RowHint}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding HardwareDecoding}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_vout}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{l:T set_vout_hint}" Style="{StaticResource RowHint}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" ItemsSource="{Binding VideoOutputOptions}" SelectedValue="{Binding VideoOutput}"/>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="{l:T set_ytdlp}" Style="{StaticResource RowLabel}"/>
              <TextBlock Style="{StaticResource RowHint}">
                <Run Text="{l:T set_ytdlp_hint}"/>
                <Run Text=" — "/>
                <Run Text="{Binding YtDlpVersion, Mode=OneWay}" FlowDirection="LeftToRight"/>
              </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="{l:T btn_update}" Command="{Binding UpdateYtDlpCommand}"
                    IsEnabled="{Binding CanUpdateYtDlp}" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ===================================================== troubleshooting -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Style="{StaticResource CardTitle}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{l:T set_trouble}" Style="{StaticResource H2}"/>
          </StackPanel>
          <TextBlock Text="{l:T set_trouble_hint}" Style="{StaticResource RowHint}" Margin="0,0,0,12"/>
          <WrapPanel>
            <Button Style="{StaticResource ButtonBase}" Content="{l:T btn_reattach}" Command="{Binding ReattachCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource ButtonBase}" Content="{l:T btn_reset_health}" Command="{Binding ResetHealthCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource ButtonBase}" Content="{l:T btn_clear_cache}" Command="{Binding ClearCacheCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource ButtonBase}" Content="{l:T btn_open_logs}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource ButtonBase}" Content="{l:T btn_open_settings}" Command="{Binding OpenSettingsFolderCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource Text3Brush}" FontSize="11.5" Margin="4,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
