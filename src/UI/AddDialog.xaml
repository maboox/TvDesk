<Window x:Class="TvDesk.UI.AddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TvDesk.Core"
        Title="TvDesk" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <StackPanel>
      <!-- header -->
      <Grid Height="52" Margin="22,0,6,0">
        <TextBlock Text="{l:T add_title}" Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center"/>
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0"
                Click="OnCancel" WindowChrome.IsHitTestVisibleInChrome="True"/>
      </Grid>

      <StackPanel Margin="22,0,22,22">
        <!-- tabs -->
        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="TabLink" Style="{StaticResource Segment}" GroupName="addtab" Checked="OnTabChanged" IsChecked="True">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="12" Margin="0,0,7,0"/>
                <TextBlock Text="{l:T add_tab_link}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TabPlaylist" Style="{StaticResource Segment}" GroupName="addtab" Checked="OnTabChanged">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="12" Margin="0,0,7,0"/>
                <TextBlock Text="{l:T add_tab_playlist}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TabFile" Style="{StaticResource Segment}" GroupName="addtab" Checked="OnTabChanged">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,7,0"/>
                <TextBlock Text="{l:T add_tab_file}"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>

        <!-- ============ link -->
        <StackPanel x:Name="LinkPanel" Margin="0,18,0,0">
          <TextBlock Text="{l:T add_link_label}" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,6"/>
          <TextBox x:Name="LinkUrl" FlowDirection="LeftToRight" Tag="https://www.youtube.com/@channel/live   ·   https://…/stream.m3u8"
                   TextChanged="OnLinkChanged"/>
          <TextBlock Text="{l:T add_link_hint}" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,6,0,0"/>
          <Border x:Name="PlaylistHint" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,8" CornerRadius="10" Background="#14FFB547" BorderBrush="#33FFB547" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:T add_looks_playlist}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
              <Button Style="{StaticResource GhostButton}" Padding="8,2" Margin="8,0,0,0" Click="OnSwitchToPlaylist" Foreground="{StaticResource AccentBrush}"
                      Content="{l:T add_switch_playlist}"/>
            </StackPanel>
          </Border>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{l:T add_name_label}" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,6"/>
              <TextBox x:Name="LinkName" Tag="{l:T add_name_placeholder}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{l:T add_category_label}" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,6"/>
              <ComboBox x:Name="LinkCategory" Height="38" ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedIndex="0"/>
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource ButtonBase}" Content="{l:T add_play_once}" Click="OnPlayLink" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Click="OnSaveLink">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Margin="0,0,8,0"/>
                <TextBlock Text="{l:T add_save_play}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- ============ playlist -->
        <StackPanel x:Name="PlaylistPanel" Margin="0,18,0,0" Visibility="Collapsed">
          <TextBlock Text="{l:T add_playlist_label}" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,6"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PlaylistUrl" FlowDirection="LeftToRight" Tag="https://…/playlist.m3u"/>
            <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="{l:T btn_browse}" Click="OnBrowsePlaylist" Margin="8,0,0,0"/>
          </Grid>
          <TextBlock Text="{l:T add_playlist_hint}" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,6,0,0"/>
          <TextBlock Text="{l:T add_name_label}" Foreground="{StaticResource Text2Brush}" Margin="0,16,0,6"/>
          <TextBox x:Name="PlaylistName" Tag="{l:T add_playlist_name_placeholder}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource ButtonBase}" Content="{l:T btn_cancel}" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Click="OnAddPlaylist">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                <TextBlock Text="{l:T btn_add_playlist}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- ============ file -->
        <StackPanel x:Name="FilePanel" Margin="0,18,0,0" Visibility="Collapsed">
          <TextBlock Text="{l:T add_file_label}" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,6"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilePath" FlowDirection="LeftToRight" Tag="C:\Videos\…\clip.mp4"/>
            <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="{l:T btn_browse}" Click="OnBrowseFile" Margin="8,0,0,0"/>
          </Grid>
          <TextBlock Text="{l:T add_file_hint}" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,6,0,0"/>
          <TextBlock Text="{l:T add_name_label}" Foreground="{StaticResource Text2Brush}" Margin="0,16,0,6"/>
          <TextBox x:Name="FileName" Tag="{l:T add_name_placeholder}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource ButtonBase}" Content="{l:T add_play_once}" Click="OnPlayFile" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Click="OnSaveFile">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Margin="0,0,8,0"/>
                <TextBlock Text="{l:T add_save_play}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BadBrush}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
