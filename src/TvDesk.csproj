<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Explicit usings everywhere: WPF and WinForms share many type names. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TvDesk</AssemblyName>
    <RootNamespace>TvDesk</RootNamespace>
    <Version>2.1.0</Version>
    <FileVersion>2.1.0.0</FileVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Product>TvDesk</Product>
    <Description>Live TV, IPTV and YouTube Live as your desktop wallpaper</Description>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- WPF owns the process DPI manifest; WinForms is used only for wallpaper/tray interop. -->
    <NoWarn>$(NoWarn);CA1416;WFAC010;NETSDK1206;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\*.ttf" />
    <Resource Include="..\assets\icon.ico" Link="Resources\icon.ico" />
    <EmbeddedResource Include="Resources\catalog.json" LogicalName="TvDesk.catalog.json" />
    <EmbeddedResource Include="Resources\tools.json" LogicalName="TvDesk.tools.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\tools\yt-dlp.exe" Condition="Exists('..\tools\yt-dlp.exe')">
      <Link>yt-dlp.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
